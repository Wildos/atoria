<footer class="atoria form-footer flexcol">
    <div class="flexrow">
        <label>{{localize "ATORIA.Dialog.Roll.Roll_visibility.Label"}}</label>
        <select name="asked_visibility">
            {{selectOptions message_modes selected=selected_message_mode localize=true}}
        </select>
    </div>
    <div class="flexrow">
        <div class="flexrow atoria-launch-cost-div" style="min-width: fit-content; flex: 0; justify-content: flex-start">
        {{#if cost}}
            {{log systemFields}}
            {{>"atoria.v2.commons_partials.cost-display"
                cost=cost
                systemFields=systemFields.cost
                hide_material=true
            }}
        {{/if}}
        </div>
        <button type="submit" data-action="ok" class="" autofocus="">
            <i class="fas fa-check"></i>
            <span>{{localize "ATORIA.Dialog.Launch"}}</span>
        </button>
    </div>
</footer>
