<li class="chat-message interactable message flexcol {{cssClass}}" data-message-id="{{message._id}}"
    {{#if borderColor}}style="border-color:{{borderColor}}"{{/if}}>
    <header class="message-header flexrow">
        <h4 class="message-sender">{{alias}}</h4>
        <span class="message-metadata">
            <time class="message-timestamp">{{timeSince message.timestamp}}</time>
            {{#if canDelete}}
            <a aria-label="{{localize "COMMON.Delete"}}" class="message-delete" data-action="deleteMessage">
                <i class="fa-solid fa-trash" inert></i>
            </a>
            {{/if}}
            {{#if canClose}}
            <a aria-label="{{ localize "CHAT.Dismiss" }}" class="message-dismiss" data-action="dismissMessage">
                <i class="fa-solid fa-xmark" inert></i>
            </a>
            {{/if}}
        </span>

        {{#if isWhisper}}
        <span class="whisper-to">{{localize 'CHAT.To'}}: {{whisperTo}}</span>
        {{/if}}

        {{#if message.flavor}}
        <span class="flavor-text"
        {{#if message.system.flavor_tooltip}}
            {{#if (or (eq user._id author._id) user.isGM)}}
            data-tooltip="{{{message.system.flavor_tooltip}}}"
            {{/if}}
        {{/if}}>{{{message.flavor}}}</span>
        {{/if}}
    </header>

    {{#if message.system.forced_title}}
    <div class="atoria">
    <h5 {{#if (or (eq user._id author._id) user.isGM)}}data-tooltip-class="atoria-tooltip" data-tooltip="{{{message.system.forced_tooltip}}}" style="position:relative"{{/if}}>{{localize message.system.forced_title}}</h5>
    </div>
    {{/if}}

    <div class="message-content">
        {{{message.content}}}
    </div>

    {{#if message.system.used_perks}}
        {{#if (or (eq user._id author._id) user.isGM)}}
            {{#each message.system.used_perks}}
            <label class="used-perk" data-tooltip="{{this.description}}">{{localize this.name}}</label>
            {{/each}}
        {{/if}}
    {{/if}}

    {{#if message.system.saves_asked}}
    <div class="interactable-content">
        <ul class="saves-asked">
        {{#each message.system.saves_asked}}
            <li data-action="rollable" data-skill-path="{{this.skill_path}}">{{localize this.name}}</li>
        {{/each}}
        </ul>
    </div>
    {{/if}}
</li>
